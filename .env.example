# Gmail OAuth 2.0 credentials
# Create these in Google Cloud Console → APIs & Services → Credentials.
# Application type: Desktop app. Add http://localhost:8080/ as a redirect URI.
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:8080/

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Who and what to summarize
SOURCE_EMAIL=isb.quantana@quantana.in
SEND_TO=you@example.com
CC_LIST=

# Schedule (24h clock, local time)
RUN_HOUR=7
RUN_MINUTE=0

# Optional: rotating log file (relative to project root)
LOG_FILE=esagent.log
